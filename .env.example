# Copy this file to .env and replace placeholder values before starting the stack.
# Never commit the real .env file.

# ── Observability ───────────────────────────────────────────────────────────
# Grafana is exposed only on localhost by docker-compose.observability.yml.
GRAFANA_ADMIN_PASSWORD=change-this-password

# ── NordVPN / Gluetun ───────────────────────────────────────────────────────
# Use NordVPN manual service credentials for OpenVPN, not your normal account
# email and password. Deluge is routed through Gluetun, while the rest of the
# media stack keeps normal Docker networking.
NORDVPN_USER=tu_usuario_manual_de_nordvpn
NORDVPN_PASSWORD=tu_password_manual_de_nordvpn

# Optional Gluetun tuning. Spain is the default used in docker-compose.yml.
# Change this in docker-compose.yml or override it if you want to test another
# nearby region for better torrent performance.
# NORDVPN_COUNTRY=Spain
