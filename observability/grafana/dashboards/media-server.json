{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Servicios Docker activos",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(time() - container_last_seen{name=~\".+\"} < 60)", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "CPU Windows",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "RAM disponible Windows",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "windows_memory_available_bytes", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Espacio libre C:",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "windows_logical_disk_free_bytes{volume=\"C:\"}", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "timeseries",
      "title": "CPU por contenedor",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m])) * 100", "legendFormat": "{{name}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Memoria por contenedor",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})", "legendFormat": "{{name}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Red recibida por contenedor",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\".+\"}[1m]))", "legendFormat": "{{name}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Red enviada por contenedor",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\".+\"}[1m]))", "legendFormat": "{{name}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "logs",
      "title": "Logs de contenedores",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{container=~\".+\"}", "refId": "A"}],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["media", "windows", "docker"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Media Server - Windows y Docker",
  "uid": "media-server-windows",
  "version": 1
}
